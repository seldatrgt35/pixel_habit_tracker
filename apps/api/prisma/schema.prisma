generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum HabitType {
  binary
  numeric
}

enum HabitColor {
  moss
  sky
  peach
  rose
}

enum HabitIcon {
  book
  water
  move
  leaf
  moon
  code
  film
}

model User {
  id String @id @default(uuid()) @db.Uuid
  firebaseUid String @unique @db.VarChar(128)
  email String? @db.VarChar(320)
  timezone String @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  habits Habit[]
}

model Habit {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String @db.VarChar(80)
  icon HabitIcon
  color HabitColor
  createdDate DateTime @db.Date
  archivedDate DateTime? @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  versions HabitVersion[]
  entries HabitEntry[]
  @@index([userId, archivedDate, createdDate])
}

model HabitVersion {
  id String @id @default(uuid()) @db.Uuid
  habitId String @db.Uuid
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime @db.Date
  effectiveTo DateTime? @db.Date
  type HabitType
  targetValue Decimal @db.Decimal(12, 3)
  unit String @db.VarChar(24)
  weekdays Int[]
  reminderEnabled Boolean @default(false)
  reminderLocalTime String? @db.VarChar(5)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  entries HabitEntry[]
  @@unique([habitId, id])
  @@unique([habitId, effectiveFrom])
}

model HabitEntry {
  id String @id @default(uuid()) @db.Uuid
  habitId String @db.Uuid
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  habitVersionId String @db.Uuid
  version HabitVersion @relation(fields: [habitId, habitVersionId], references: [habitId, id], onDelete: Cascade)
  entryDate DateTime @db.Date
  value Decimal @db.Decimal(12, 3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  items HabitEntryItem[]
  @@unique([habitId, entryDate])
}

model HabitEntryItem {
  id String @id @default(uuid()) @db.Uuid
  habitEntryId String @db.Uuid
  entry HabitEntry @relation(fields: [habitEntryId], references: [id], onDelete: Cascade)
  text String @db.VarChar(160)
  position Int @db.SmallInt
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([habitEntryId, position])
}
